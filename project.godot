3d_physics/layer_2="personagens"
3d_physics/layer_3="interacao"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=2
environment/defaults/default_clear_color=Color(0.66, 0.85, 0.92, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2

[gui]

theme/default_font_multichannel_signed_distance_field=true
